{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newsglo",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "custom-worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "0 0 */3 * *",
      "0 * * * *",
      "*/30 * * * *"
    ]
  }
}
